JWT_EXPIRES_IN=15m

# Optional; setting both provisions an administrator at startup.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

DEMO_USER_COUNT=10
DEMO_SEAT_COUNT=10
DEMO_WALLET_BALANCE=1000.00