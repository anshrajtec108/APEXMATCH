PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ticket_booking
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
